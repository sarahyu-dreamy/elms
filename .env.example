# 이 값들은 드리미 포털이 Vercel 에 자동 주입합니다 — 배포 시에는 따로 넣을 필요 없어요.
# 로컬(npm run dev)에서 시험할 때만, 포털 "백엔드 카드"의 값을 복사해 .env.local 로 만드세요.

# ── 내 Supabase 백엔드 ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 공유 백엔드면 내 전용 schema(app_<id>). 전용 백엔드면 비워두면 public 사용.
NEXT_PUBLIC_SUPABASE_SCHEMA=

# ── 드리미로 로그인 (OAuth) ──
DREAMI_ISSUER=https://stu.dreamyedu.net
DREAMI_CLIENT_ID=
# 서버에서만 사용 — 절대 NEXT_PUBLIC_ 으로 바꾸지 마세요(프론트 노출 금지).
DREAMI_CLIENT_SECRET=
